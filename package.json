{
  "name": "ssl-manager",
  "version": "1.0.0",
  "description": "SSL certificate management system",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web-main": "pnpm --filter web-main dev",
    "dev:web-admin": "pnpm --filter web-admin dev",
    "dev:backend": "pnpm --filter backend-main dev",
    "build:all": "pnpm -r build",
    "build:web-main": "pnpm --filter web-main build",
    "build:web-admin": "pnpm --filter web-admin build",
    "build:backend": "pnpm --filter backend-main build",
    "deploy:web-main": "pnpm --filter web-main deploy",
    "deploy:backend": "pnpm --filter backend-main deploy",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "fmt": "pnpm -r fmt",
    "fmt:check": "pnpm -r fmt:check"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}